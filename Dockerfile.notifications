FROM node:20-alpine

WORKDIR /app

# Copiar package files
COPY package*.json ./
COPY tsconfig.json ./

# Instalar dependencias
RUN npm install --omit=dev

# Copiar código fuente
COPY src ./src

# Build TypeScript
RUN npm run build || npx tsc

# Comando para iniciar el microservicio de notificaciones
CMD ["node", "dist/ms-notifications/worker.js"]
