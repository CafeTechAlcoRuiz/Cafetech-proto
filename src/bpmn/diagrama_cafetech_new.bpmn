<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_12dbx96" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.43.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="Process_CafeTech" name="Proceso de Ordenes CafeTech" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Orden Recibida">
      <bpmn:outgoing>Flow_0k9d8f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_0k9d8f1" sourceRef="StartEvent_1" targetRef="Activity_ValidarStock" />
    <bpmn:serviceTask id="Activity_ValidarStock" name="Validar Stock y Datos">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validar-stock" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0k9d8f1</bpmn:incoming>
      <bpmn:outgoing>Flow_1vo4c3b</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Validacion" name="¿Datos Validos?" default="Flow_ToCobro">
      <bpmn:incoming>Flow_1vo4c3b</bpmn:incoming>
      <bpmn:outgoing>Flow_ToCobro</bpmn:outgoing>
      <bpmn:outgoing>Flow_Invalid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1vo4c3b" sourceRef="Activity_ValidarStock" targetRef="Gateway_Validacion" />
    <bpmn:sequenceFlow id="Flow_ToCobro" name="Sí" sourceRef="Gateway_Validacion" targetRef="Activity_CobrarOrden" />
    <bpmn:endEvent id="Event_OrdenRechazada" name="Orden Rechazada">
      <bpmn:incoming>Flow_Invalid</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Invalid" name="No (Stock/Datos)" sourceRef="Gateway_Validacion" targetRef="Event_OrdenRechazada">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=esValido = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Activity_CobrarOrden" name="Realizar Cobro">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="cobrar-orden" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToCobro</bpmn:incoming>
      <bpmn:outgoing>Flow_0bz1d3x</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0bz1d3x" sourceRef="Activity_CobrarOrden" targetRef="Activity_Cocina" />
    <bpmn:serviceTask id="Activity_Cocina" name="Preparar en Cocina">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="preparar-orden" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0bz1d3x</bpmn:incoming>
      <bpmn:outgoing>Flow_1g8o9j2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Event_ErrorCocina" name="Error en Cocina" attachedToRef="Activity_Cocina">
      <bpmn:outgoing>Flow_ToCompensate</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_1x2y3z" errorRef="Error_CocinaFallo" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_ToCompensate" sourceRef="Event_ErrorCocina" targetRef="Activity_Reembolso" />
    <bpmn:serviceTask id="Activity_Reembolso" name="Reembolsar Dinero (Compensación)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="reembolsar-dinero" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToCompensate</bpmn:incoming>
      <bpmn:outgoing>Flow_ToNotifyFail</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_NotificarFallo" name="Notificar Cancelación">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notificar-usuario" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToNotifyFail</bpmn:incoming>
      <bpmn:outgoing>Flow_EndError</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToNotifyFail" sourceRef="Activity_Reembolso" targetRef="Activity_NotificarFallo" />
    <bpmn:endEvent id="Event_FinError" name="Fin con Error Compensado">
      <bpmn:incoming>Flow_EndError</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_EndError" sourceRef="Activity_NotificarFallo" targetRef="Event_FinError" />
    <bpmn:sequenceFlow id="Flow_1g8o9j2" sourceRef="Activity_Cocina" targetRef="Activity_NotificarLista" />
    <bpmn:serviceTask id="Activity_NotificarLista" name="Notificar: Orden Lista">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notificar-usuario" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1g8o9j2</bpmn:incoming>
      <bpmn:outgoing>Flow_ToDelivery</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToDelivery" sourceRef="Activity_NotificarLista" targetRef="Activity_Entrega" />
    <bpmn:serviceTask id="Activity_Entrega" name="Asignar Repartidor">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="asignar-delivery" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToDelivery</bpmn:incoming>
      <bpmn:outgoing>Flow_ToSuccess</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_Exito" name="Orden Entregada">
      <bpmn:incoming>Flow_ToSuccess</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToSuccess" sourceRef="Activity_Entrega" targetRef="Event_Exito" />
    
    <bpmn:subProcess id="Activity_GlobalCancel" name="Manejo de Cancelación Global" triggeredByEvent="true">
      <bpmn:startEvent id="Event_SignalCancel" name="Señal: CANCELAR_TODO" isInterrupting="true">
        <bpmn:outgoing>Flow_SubStart</bpmn:outgoing>
        <bpmn:signalEventDefinition id="SignalEventDefinition_1" signalRef="Signal_Cancelacion" />
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="Flow_SubStart" sourceRef="Event_SignalCancel" targetRef="Activity_LogCancel" />
      
      <bpmn:serviceTask id="Activity_LogCancel" name="Loggear Cancelación Forzada">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="log-error" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_SubStart</bpmn:incoming>
        <bpmn:outgoing>Flow_DirectToRefund</bpmn:outgoing>
      </bpmn:serviceTask>
      
      <bpmn:sequenceFlow id="Flow_DirectToRefund" sourceRef="Activity_LogCancel" targetRef="Activity_Sub_Reembolso" />
      
      <bpmn:serviceTask id="Activity_Sub_Reembolso" name="Reembolsar (Urgente)">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="reembolsar-dinero" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_DirectToRefund</bpmn:incoming>
        <bpmn:outgoing>Flow_SubEnd</bpmn:outgoing>
      </bpmn:serviceTask>
      
      <bpmn:endEvent id="End_SignalSub" name="Fin Cancelación">
        <bpmn:incoming>Flow_SubEnd</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_SubEnd" sourceRef="Activity_Sub_Reembolso" targetRef="End_SignalSub" />
    </bpmn:subProcess>

  </bpmn:process>
  <bpmn:error id="Error_CocinaFallo" name="ErrorCocina" errorCode="ERROR_COCINA" />
  <bpmn:signal id="Signal_Cancelacion" name="CANCELAR_TODO" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_CafeTech">
