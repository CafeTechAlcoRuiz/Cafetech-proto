      <bpmndi:BPMNShape id="Activity_1l5k6j7_di" bpmnElement="Activity_NotificarLista">
        <dc:Bounds x="850" y="137" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_1m8n9b0_di" bpmnElement="Activity_Entrega">
        <dc:Bounds x="1010" y="137" width="100" height="80" />
