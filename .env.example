# Environment
NODE_ENV=production

# JWT
JWT_SECRET=tu_super_secret_jwt_key_aqui_cambia_esto

# RabbitMQ (CloudAMQP)
# Formato: amqps://usuario:contraseña@host/vhost
RABBITMQ_URL=amqps://usuario:contraseña@fox.rmq.cloudamqp.com/usuario

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu_contraseña_postgres_aqui
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cafetech

# MongoDB
MONGO_USER=admin
MONGO_PASSWORD=tu_contraseña_mongo_aqui
MONGO_URI=mongodb://admin:contraseña@mongo:27017/cafetech?authSource=admin

# Zeebe (Camunda BPM)
ZEEBE_URL=http://zeebe:26500
ZEEBE_INSECURE_CONNECTION=true
